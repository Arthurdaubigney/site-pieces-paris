---
import { Image } from 'astro:assets';
import { photos, type PhotoKey } from '../data/images';

interface Props {
  name: PhotoKey;
  width?: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  alt?: string;
  title?: string;
}
const { name, width = 900, sizes = '(max-width: 760px) 100vw, 50vw', loading = 'lazy', class: cls, alt, title } = Astro.props;
const p = photos[name];
const eager = loading === 'eager';
const widths = [Math.round(width / 2), width, width * 2].filter((w) => w <= p.src.width);
---
<Image
  src={p.src}
  alt={alt ?? p.alt}
  title={title ?? p.title}
  width={width}
  widths={widths.length ? widths : [p.src.width]}
  sizes={sizes}
  class={cls}
  loading={loading}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : 'auto'}
  format="webp"
  quality={78}
/>
