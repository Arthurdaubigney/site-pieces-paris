---
interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs wrap" aria-label="Fil d’Ariane">
  <ol>
    <li><a href="/">Accueil</a></li>
    {items.map((i) => <li>{i.href ? <a href={i.href}>{i.name}</a> : <span aria-current="page">{i.name}</span>}</li>)}
  </ol>
</nav>
